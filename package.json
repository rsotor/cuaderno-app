{
  "name": "cuaderno-app",
  "version": "0.1.0",
  "private": true,
  "description": "Un cuaderno de estudio en el navegador: lee y edita las notas Markdown de un curso montado con profesor-kit, y habla con el profesor sin salir de la ventana.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "test:navegador": "node --test --test-concurrency=2 \"tests/navegador/*.test.js\"",
    "test:electron": "node --test \"tests/electron/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"pruebas/**\" \"tests/*.test.js\"",
    "cobertura:pantalla": "node -e \"require('fs').rmSync('.cobertura-pantalla',{recursive:true,force:true})\" && CUADERNO_COBERTURA_PANTALLA=.cobertura-pantalla npm run test:navegador && node pruebas/cobertura-pantalla.js .cobertura-pantalla"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/markdown": "1.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "playwright": "1.56.1"
  },
  "main": "electron/main.js"
}
