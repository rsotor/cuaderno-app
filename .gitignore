# Dependencias
node_modules/

# Secretos: nunca entran en el repo (los nombres, sin valores, van en .env.example)
.env
.env.*
*.pem
*.key

# Descargas y archivos sueltos: se versiona lo extraído, no el zip
*.zip

# Copias temporales de cuadernos para probar (nunca los cuadernos reales ni sus rutas)
cuadernos-prueba/

# Sistema
.DS_Store
Thumbs.db
*.tmp
*~
.cobertura-pantalla/

# Árboles de trabajo de los agentes de Claude Code (copias temporales del repo)
.claude/worktrees/

# La app empaquetada (npm run empaquetar) y los iconos que electron-builder derive del PNG
dist-app/
electron/icono/*.icns
electron/icono/*.ico
